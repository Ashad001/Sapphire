# Ask Screen credentials. Copy to .env (repo root, dev only) or to
# ~/Library/Application Support/Sapphire/.env for an installed .app —
# a .app launched from Finder does not inherit your shell environment.
# Never commit the real .env.

# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-opus-5

# Optional. OpenRouter reasoning effort: low | medium | high.
# Use "off" (or none/omit) to send no reasoning parameter at all — some endpoints
# reject the parameter outright with 400 "Reasoning is mandatory for this endpoint".
# Defaults to low.
OPENROUTER_REASONING=low
